# Panchmukhi Trading Brain Pro - Environment Configuration Template
# Copy this file to .env and update the values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database (Primary Database)
POSTGRES_DB=panchmukhi_trading
POSTGRES_USER=panchmukhi_user
POSTGRES_PASSWORD=panchmukhi_pass

# MongoDB Database (Logs and Time-series Data)
MONGO_INITDB_ROOT_USERNAME=panchmukhi_admin
MONGO_INITDB_ROOT_PASSWORD=panchmukhi_admin_pass
MONGO_INITDB_DATABASE=panchmukhi_logs

# Redis Cache
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret Key (Change this in production!)
JWT_SECRET=panchmukhi-super-secret-key-change-in-production-for-docker

# CORS Configuration
CORS_ORIGIN=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8083

# API Configuration
API_VERSION=v1
API_BASE_PATH=/api

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8083

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# ML Services URL
ML_SERVICE_URL=http://ml-services:8000
ML_SERVICE_TIMEOUT=30000

# Email Configuration (Optional - for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@panchmukhi-trading.com
MAIL_FROM_NAME="Panchmukhi Trading"

# SMS Configuration (Optional - for 2FA and alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================================
# MARKET DATA CONFIGURATION
# =============================================================================

# Market Data Sources
MARKET_DATA_ENABLED=true
MARKET_DATA_UPDATE_INTERVAL=30000

# NSE/BSE API Configuration (Optional - for real data)
NSE_API_KEY=
BSE_API_KEY=
ALPHA_VANTAGE_API_KEY=

# =============================================================================
# NEWS & SENTIMENT CONFIGURATION
# =============================================================================

# News API Configuration
NEWS_API_ENABLED=true
NEWS_UPDATE_INTERVAL=300000
NEWS_API_KEY=

# Sentiment Analysis
SENTIMENT_ENABLED=true
SENTIMENT_LANGUAGES=mr,hi,en,gu,kn

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/application.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=10

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin123
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_SCRAPE_INTERVAL=15s

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30s

# =============================================================================
# ML SERVICES CONFIGURATION
# =============================================================================

# Model Configuration
MODEL_UPDATE_INTERVAL=3600000
MODEL_RETRAIN_INTERVAL=86400000

# Prediction Settings
PREDICTION_ENABLED=true
PREDICTION_CONFIDENCE_THRESHOLD=0.7

# Risk Analysis
RISK_ANALYSIS_ENABLED=true
RISK_VAR_CONFIDENCE=0.95

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Trading Settings
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false

# Alert Settings
ALERT_CHECK_INTERVAL=60000
ALERT_EXPIRY_HOURS=24

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Hot Reload
SPRING_DEVTOOLS_RESTART_ENABLED=true
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true

# Debug Settings
DEBUG_MODE=false
DEBUG_PORT=5005

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# Uncomment and modify these for production deployment
# APP_ENV=production
# APP_DEBUG=false
# CORS_ORIGIN=https://yourdomain.com
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# LOG_LEVEL=WARN
# PAPER_TRADING_ENABLED=false
# LIVE_TRADING_ENABLED=true

# =============================================================================
# NOTES
# =============================================================================

# IMPORTANT: 
# 1. Change JWT_SECRET in production
# 2. Set strong passwords for databases
# 3. Configure email/SMS for notifications
# 4. Set proper CORS origins for production
# 5. Enable SSL/TLS for production deployment
# 6. Configure real API keys for market data
# 7. Set up proper monitoring and alerting